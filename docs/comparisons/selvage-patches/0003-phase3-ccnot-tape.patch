+# The conformance scenario of the CCNOT tape (VI.6): 40 draws, a birth, 20 draws from the child,
+# and a birth taken back.  Its output is ccnot_tape.trace, a trace of moop's own implementation.
+rule born takes CcnotTape returns (CcnotTape, CcnotTape)
+    t <-> (child, t) where
+        child is t -> birth()
+
+rule main uses Output
+    a is array(Bit, 8)
+    b is array(Bit, 13)
+    repeat with k from 0 to 7
+        set a[k] to Bit((k * k + 1) mod 2)
+    repeat with k from 0 to 12
+        set b[k] to Bit(((k * 5) / 3 + 1) mod 2)
+    tape is CcnotTape from Tapes(a, b, 0, 0)
+    output tape
+    repeat with k from 1 to 40
+        d is tape -> draw()
+        output d
+    output tape
+    (child, parent) is born(tape)
+    output parent
+    output child
+    repeat with k from 1 to 20
+        d is child -> draw()
+        output d
+    output child
+    a2 is array(Bit, 8)
+    b2 is array(Bit, 13)
+    repeat with k from 0 to 7
+        set a2[k] to Bit((k * k + 1) mod 2)
+    repeat with k from 0 to 12
+        set b2[k] to Bit(((k * 5) / 3 + 1) mod 2)
+    again is CcnotTape from Tapes(a2, b2, 0, 0)
+    repeat with k from 1 to 40
+        d is again -> draw()
+    (c2, p2) is born(again)
+    output undo born((c2, p2))
