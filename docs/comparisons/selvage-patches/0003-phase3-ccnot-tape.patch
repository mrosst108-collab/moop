+# ---- the CCNOT tape: the prelude's CcnotTape against a model of wiring 1 of its own ---------
+class TapeModel:
+    """Wiring 1, written from its description and sharing no code with the interpreter: two
+    CCNOTs share the cells under both heads as controls and target the next cell of each tape;
+    then head i moves forward and head j backward.  A draw ticks and reads the cell under i."""
+    def __init__(self, a, b, i, j):
+        self.a, self.b, self.i, self.j = list(a), list(b), i, j
+
+    def tick(self):
+        c = self.a[self.i] & self.b[self.j]
+        self.a[(self.i + 1) % len(self.a)] ^= c
+        self.b[(self.j - 1) % len(self.b)] ^= c
+        self.i, self.j = (self.i + 1) % len(self.a), (self.j - 1) % len(self.b)
+
+    def draw(self):
+        self.tick()
+        return self.a[self.i]
+
+    def birth(self):
+        ca = [self.draw() for _ in self.a]
+        cb = [self.draw() for _ in self.b]
+        return TapeModel(ca, cb, 0, 0)
+
+    def value(self):
+        return (self.a, self.b, self.i, self.j)
+
+
+def tape_state(a, b, i, j):
+    return Form('Tapes', (Arr('Bit', [Word(x, 'Bit') for x in a]), Arr('Bit', [Word(x, 'Bit') for x in b]),
+                          Word(i, 'I64'), Word(j, 'I64')))
+
+
+def tape_value(state):
+    a, b, i, j = state.kids
+    return ([w.v for w in a.data], [w.v for w in b.data], i.v, j.v)
+
+
+def tape(programs=200, seed=1):
+    """Draws and births of the prelude's CcnotTape against the model, on random tapes of 2 to 16
+    cells; every draw and birth taken back by `undo`; and the tick against its derived inverse."""
+    rng = random.Random(seed)
+    stats = {'tapes': 0, 'draws': 0, 'births': 0, 'taken back': 0, 'ticks undone': 0}
+    findings = []
+    m = load('')[0]
+    if 'CcnotTape' not in m.answers or 'tape_tick' not in m.rules:
+        return stats, [('the prelude has no CCNOT tape', '', '')]
+    tick = m.rules['tape_tick']
+    for _ in range(programs):
+        la, lb = rng.randint(2, 16), rng.randint(2, 16)
+        a, b = [rng.randint(0, 1) for _ in range(la)], [rng.randint(0, 1) for _ in range(lb)]
+        i, j = rng.randrange(la), rng.randrange(lb)
+        where = f'a={a} b={b} i={i} j={j}'
+        stats['tapes'] += 1
+        model, it = TapeModel(a, b, i, j), Interp(m)
+        inst, history = Inst('CcnotTape', (), tape_state(a, b, i, j)), []
+        try:
+            for _ in range(rng.randint(0, 40)):
+                before = deep_copy(inst)
+                reply, inst = it.send(inst, 'draw', ())
+                history.append((before, 'draw', reply))
+                stats['draws'] += 1
+                if reply.v != model.draw() or tape_value(inst.state) != model.value():
+                    findings.append(('a draw differs from the model', where, f'after {stats["draws"]} draws'))
+                    break
+            if rng.random() < 0.5:
+                before = deep_copy(inst)
+                child, inst = it.send(inst, 'birth', ())
+                history.append((before, 'birth', deep_copy(child)))    # the child as born; it draws below
+                stats['births'] += 1
+                kid = model.birth()
+                if tape_value(child.state) != kid.value() or tape_value(inst.state) != model.value():
+                    findings.append(('a birth differs from the model', where, tape_value(child.state)))
+                for _ in range(rng.randint(0, 10)):
+                    reply, child = it.send(child, 'draw', ())
+                    if reply.v != kid.draw():
+                        findings.append(('a child draws other than the model', where, ''))
+                        break
+            for before, op, reply in reversed(history):
+                _, inst = it.unsend_any(inst, op, reply)
+                stats['taken back'] += 1
+                if inst != before:
+                    findings.append((f'taking back a {op} did not restore the tape', where, ''))
+                    break
+            state = tape_state(a, b, i, j)
+            ticked = it.forward(tick, (), deep_copy(state))
+            ref = TapeModel(a, b, i, j)
+            ref.tick()
+            if tape_value(ticked) != ref.value() or it.undo(tick, (), ticked) != state:
+                findings.append(('a tick, or its derived inverse', where, ''))
+            stats['ticks undone'] += 1
+        except Fault as e:
+            findings.append(('a tape of two cells or more was refused', where, str(e)))
+    return stats, findings
+
+
