{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bookended-thinking/schemas/pole_classification.json",
  "title": "Pole classification (Mode A, pre-run)",
  "description": "Output of the pole classifier. Note the absence of any bridge field: before a run there is no bridge, and a schema that offers the slot invites the classifier to fill it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["text_id", "mode", "ontology_version", "declarations", "dynamics", "closure_criterion_declared", "typing_proposal"],
  "properties": {
    "text_id": {"type": "string", "minLength": 1},
    "mode": {"const": "pole_typing"},
    "ontology_version": {"type": "string", "minLength": 1},
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "role", "statement", "relation", "support", "evidence"],
        "properties": {
          "layer": {"$ref": "#/$defs/layer"},
          "role": {"enum": ["opening", "closure", "both"]},
          "statement": {"type": "string"},
          "relation": {"$ref": "#/$defs/relation"},
          "support": {"$ref": "#/$defs/support"},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "dynamics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object", "invocation", "support", "evidence"],
        "properties": {
          "object": {"$ref": "#/$defs/object"},
          "invocation": {"enum": ["explicit", "described", "uncertain"]},
          "support": {"$ref": "#/$defs/support"},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "closure_criterion_declared": {"type": "boolean"},
    "typing_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "description": "A proposal only. A typing verdict is a kappa act, and kappa is held by the student. The engine reads this alongside the student's adjudication and never collapses the two.",
      "properties": {
        "status": {"enum": ["well_typed", "ill_typed", "ambiguous"]},
        "reason": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "left_open": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "layer": {"enum": ["L1", "L2", "L3", "L4", "L5", "L6"]},
    "object": {"enum": ["J_sharp", "G_sharp", "G_tilde_sharp", "Sigma", "F", "kappa", "gamma", "none", "uncertain"]},
    "relation": {"enum": ["performed_within", "evaluated_under", "path_level", "none", "uncertain"]},
    "support": {
      "enum": ["clear", "contested", "uncertain"],
      "description": "Ordinal, not numeric. A float here would be averaged downstream and become a measurement it cannot support. Dispersion comes from resampling."
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Verbatim spans from the source. The engine checks that each occurs in the source text and downgrades support to uncertain when it does not."
    }
  }
}
