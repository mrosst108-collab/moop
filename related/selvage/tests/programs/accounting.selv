type Shape
    Circle(r: I64)
    Square(side: I64)
    Tri(a: I64, b: I64)

type Wrap
    Only(n: I64, flag: Bool)

rule area takes Shape returns I64
    Circle(r) => r
    other => 0 where
        discard other

rule pick takes (Bit, Trit) returns Bit
    (0, t) => 0 where
        discard t
    (1, t) => 0 where
        discard t

rule made takes I64 returns I64
    n => n where
        w is Only(n, true)
        discard w

rule copy takes (I64, I64) returns I64
    (a, b) => a where
        t is a
        discard t
        discard b

rule named takes (Text, I64) returns I64
    (t, n) => n where
        discard t

rule main uses Output, System
    output area(Circle(3))
    output area(Square(4))
    output area(Tri(1, 2))
    output pick((0, maybe))
    output pick((1, true))
    output made(7)
    output copy((5, 6))
    output named(("hello", 9))
